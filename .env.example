# Copy to .env.local and fill in. On Vercel, add the same names under Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: a free MapTiler key (cloud.maptiler.com) turns on the Map / Satellite toggle.
# The street map always uses OpenFreeMap, which needs no key.
NEXT_PUBLIC_MAPTILER_KEY=
